# --- Режим ---
APP_ENV=dev                      # production: требует SECRET_KEY, не сидит демо-пользователей
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///./kedr.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Детекция (RTX 3050) ---
YOLO_WEIGHTS=weights/yolov8x-fire.pt
YOLO_WEIGHTS_URL=                # необязательно: ссылка на .pt, скачается при первом запуске
YOLO_DEVICE=cuda:0
YOLO_HALF=true
FRAME_SAMPLE_FPS=1
TIER_PENDING=0.40
TIER_CRITICAL=0.80

# --- Защита ---
MAX_UPLOAD_MB=100
RATE_LIMIT_PER_MIN=10

# --- Внешние сервисы (без ключей) ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=kedr-fire-monitor/1.0 (contact: memak@gmail.com)

# --- Overpass / кэш (item 4: ускорение создания инцидента) ---
OVERPASS_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_TIMEOUT=60              # секунд на запрос к зеркалу; следующее зеркало берётся при ошибке
OVERPASS_CONCURRENCY=4           # одновременных запросов к Overpass
CACHE_MAX=4000                   # максимум записей в in-process TTL-кэше
WEATHER_TTL=600                  # сек: кэш погоды Open-Meteo
GEOCODE_TTL=86400                # сек: кэш обратного геокодирования Nominatim
NEAR_TTL=1800                    # сек: кэш населённых пунктов и landuse (nearby)
INFRA_TTL=1800                   # сек: кэш объектов инфраструктуры (item 7)
SEARCH_TTL=3600                  # сек: кэш поиска населённых пунктов
CLEAR_DEDUPE_KM=0.5              # км: радиус схлопывания повторных CLEAR-детекций

# --- Демо-данные (только dev) ---
SEED_ON_STARTUP=true
SEED_PASSWORD=123456


HAZARD_RADIUS_M=30000